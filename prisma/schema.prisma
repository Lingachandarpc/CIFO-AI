generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  image     String?
  emailVerified DateTime?
  password  String?  // For credentials provider (bcrypt hashed)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Freemium token system
  tokenBudget    Int      @default(50000)   // Monthly token allowance (free tier: 50k)
  tokensUsed     Int      @default(0)       // Tokens used in current period
  tier           String   @default("free")  // free, pro, enterprise
  periodStart    DateTime @default(now())   // Current billing period start
  serviceLocked  Boolean  @default(false)   // Super admin hard lock for all AI services
  sessionResponseLimit Int?                 // Optional per-session response cap override
  disabledTools  String[] @default([])      // Disabled tool ids for this user
  disabledModels String[] @default([])      // Disabled model ids for this user

  // Relations
  accounts         Account[]
  sessions         Session[]
  profile          UserProfile?
  settings         UserSettings?
  chatHistory      ChatHistory[]
  tokenUsage       TokenUsageLog[]
}

model Account {
  id                 Int       @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  aiResponsesUsed Int   @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlobalUsagePolicy {
  id                          Int      @id @default(autoincrement())
  lockAllUsers                Boolean  @default(false)
  defaultSessionResponseLimit Int?
  disabledTools               String[] @default([])
  disabledModels              String[] @default([])
  enabledModelsByTool         Json?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User Profile - Extended user information for personalization
model UserProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  country         String?  // Country name (inferred from queries or profile setup)
  state           String?  // State/Province (for weather, news context)
  location        String?  // Full location string (city, etc)
  interests       String?  // JSON or comma-separated tags - learned from queries
  pulse           String?  // User's unique vibe/personality descriptor
  bio             String?
  age             Int?
  questionTypes   String?  // JSON: categories of questions user asks
  preferredLength String?  // "concise", "detailed", "balanced"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions    UserInteractionHistory[]

  @@index([userId])
}

// User Interaction History - Track queries to learn user patterns
model UserInteractionHistory {
  id           Int      @id @default(autoincrement())
  profileId    Int
  query        String
  category     String?  // "time", "weather", "learning", "research", etc
  responseLength Int?   // words in response
  timestamp    DateTime @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([timestamp])
}

// User Settings - Narration preferences per user
model UserSettings {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  narrationTime Int      @default(5)     // minutes
  narrationType String   @default("Realistic") // Realistic, Dramatic, Educational
  voiceType     String   @default("en-US-Standard-C")
  voiceGender   String   @default("auto")
  language      String   @default("English")
  ttsProvider   String   @default("google") // google, openai, or elevenlabs
  aiModel       String   @default("auto") // auto, openai, claude-sonnet, xai
  enableBackgroundMusic Boolean @default(true)
  backgroundMusicVolume Float   @default(0.15)  // 0.0 - 1.0
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Chat History - User interactions for learning preferences & personalization
model ChatHistory {
  id         Int      @id @default(autoincrement())
  userId     Int
  role       String   // "user" or "assistant"
  content    String
  mode       String?  // "BOOK" or "CASE_STUDY"
  audioBlob  String?  // base64 encoded audio
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

// User Insights - Derived data for personalization (optional, for analytics)
model UserInsight {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  topTopics       String?  // JSON: most queried topics
  preferredMode   String?  // "BOOK" or "CASE_STUDY"
  preferredVoice  String?
  likeCount       Int      @default(0)
  dislikeCount    Int      @default(0)
  lastActiveAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// Token Usage Log - Per-request token tracking for freemium billing
model TokenUsageLog {
  id               Int      @id @default(autoincrement())
  userId           Int
  model            String   // e.g. "gpt-4-turbo", "gemini-1.5-flash"
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCost    Float    @default(0) // USD
  queryType        String?  // "text", "image", "video", "tts"
  timestamp        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([userId, timestamp])
}
